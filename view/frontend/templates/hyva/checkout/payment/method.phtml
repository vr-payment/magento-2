/** @var Magento\Framework\View\Element\Template $block */
/** @var VRPayment\Payment\ViewModel\WhitelabelMachineNameCheckoutViewModel $viewModel */

$viewModel = $block->getViewModel();
$method = $block->getMethod();
if (!$method) {
    return;
}
$methodCode = $method->getCode();

// Only proceed if it's one of our payment methods.
if (strpos($methodCode, 'vrpayment_payment_') !== 0) {
    return;
}

$configData = $viewModel->getPaymentIntegrationData($methodCode);
$configData['methodCode'] = $methodCode;
?>

<div x-data="hyvaCheckoutWhitelabelPaymentMethod"
     data-config="<?= $block->escapeHtmlAttr(json_encode($configData)) ?>"
     class="vrpayment-payment-method-container mt-4"
     id="vrpayment-container-<?= $block->escapeHtmlAttr($methodCode) ?>">
    
    <div x-show="isIframeMode" id="vrpayment-iframe-<?= $block->escapeHtmlAttr($methodCode) ?>" class="vrpayment-iframe-wrapper border rounded p-2 bg-white shadow-sm" style="display: none;">
        <!-- Iframe will be mounted here -->
    </div>
</div>
