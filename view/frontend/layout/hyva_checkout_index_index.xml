<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <script src="VRPayment_Payment::js/vrpayment-sdk-loader.js" />
        <script src="VRPayment_Payment::js/hyva-checkout-component.js" />
    </head>
    <body>
        <referenceBlock name="checkout.payment.methods">
            <block class="Magento\Framework\View\Element\Template"
                   name="checkout.payment.method.vrpayment"
                   template="VRPayment_Payment::hyva/checkout/payment/method.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">VRPayment\Payment\ViewModel\WhitelabelMachineNameCheckoutViewModel</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
